*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg:           #0d1117;
  --surface:      #161b22;
  --surface-2:    #1c2128;
  --surface-3:    #21262d;
  --border:       rgba(255,255,255,0.08);
  --border-hover: rgba(255,255,255,0.15);

  --white:        #e6edf3;
  --gray-300:     #b1bac4;
  --gray-400:     #848d97;
  --gray-500:     #545d68;
  --gray-600:     #30363d;

  --blue:         #2f81f7;
  --blue-dim:     rgba(47,129,247,0.1);
  --blue-border:  rgba(47,129,247,0.3);
  --red:          #f85149;
  --red-dim:      rgba(248,81,73,0.1);
  --green:        #3fb950;
  --green-dim:    rgba(63,185,80,0.1);
  --amber:        #d29922;
  --amber-dim:    rgba(210,153,34,0.1);

  --font-body: 'Inter', -apple-system, sans-serif;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
}

html, body {
  background: var(--bg) !important;
  color: var(--white);
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  height: 100%;
}

::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--gray-600); border-radius: 3px; }

.hidden { display: none !important; }

/* ── LAYOUT ──────────────────────────────── */
.layout { display: flex; height: 100vh; overflow: hidden; }

/* ── SIDEBAR ─────────────────────────────── */
.sidebar {
  width: 220px;
  background: var(--surface);
  border-right: 1px solid var(--border);
  padding: 20px 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex-shrink: 0;
}

.logo {
  padding: 6px 8px 16px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 6px;
}

.logo h2 {
  font-size: 14px;
  font-weight: 600;
  color: var(--white);
  letter-spacing: -0.01em;
}

.logo-sub {
  font-size: 11px;
  color: var(--gray-400);
  margin-top: 2px;
}

.nav-btn {
  width: 100%;
  padding: 8px 12px;
  border: none;
  border-radius: var(--radius-sm);
  cursor: pointer;
  background: transparent;
  color: var(--gray-300);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  text-align: left;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.15s;
}

.nav-btn:hover { background: var(--surface-3); color: var(--white); }

.nav-btn.active {
  background: var(--blue-dim);
  color: var(--blue);
  border: 1px solid var(--blue-border);
}

.nav-btn.danger { color: var(--red); }
.nav-btn.danger:hover { background: var(--red-dim); }
.nav-btn.danger.active {
  background: var(--red-dim);
  border: 1px solid rgba(248,81,73,0.3);
}

.nav-btn.btn-volver { color: var(--gray-400); margin-bottom: 6px; }
.nav-btn.btn-volver:hover { color: var(--white); }

.sidebar-spacer { flex: 1; }

.sidebar-footer {
  padding: 10px 8px 0;
  border-top: 1px solid var(--border);
  font-size: 11px;
  color: var(--gray-500);
}

/* ── MAIN ────────────────────────────────── */
.main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

/* ── TOP PANEL ───────────────────────────── */
.top-panel {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 20px 24px;
  flex-shrink: 0;
}

.top-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
  gap: 12px;
}

.top-panel h1 {
  font-size: 16px;
  font-weight: 600;
  color: var(--white);
  letter-spacing: -0.01em;
}

.contador-clientes {
  font-size: 11px;
  color: var(--gray-400);
  margin-top: 2px;
}

.top-panel-actions { display: flex; align-items: center; gap: 8px; }

.btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 14px; border-radius: var(--radius-sm);
  font-family: var(--font-body); font-size: 13px; font-weight: 500;
  cursor: pointer; border: none; transition: all 0.15s; white-space: nowrap;
}
.btn-blue    { background: var(--blue); color: #fff; }
.btn-blue:hover { background: #388bfd; }
.btn-ghost   { background: transparent; color: var(--gray-300); border: 1px solid var(--border-hover); }
.btn-ghost:hover { background: var(--surface-3); color: var(--white); }
.btn-red     { background: var(--red-dim); color: var(--red); border: 1px solid rgba(248,81,73,0.25); }
.btn-red:hover { background: rgba(248,81,73,0.18); }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }

/* Buscador */
.search-wrap { position: relative; }
.search-wrap svg {
  position: absolute; left: 10px; top: 50%;
  transform: translateY(-50%); pointer-events: none;
  color: var(--gray-400);
}

#dniInput {
  width: 320px;
  padding: 8px 12px 8px 34px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-hover);
  background: var(--bg);
  color: var(--white);
  font-family: var(--font-body);
  font-size: 13px;
  outline: none;
  transition: border-color 0.15s;
}
#dniInput::placeholder { color: var(--gray-500); }
#dniInput:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(47,129,247,0.12); }

/* ── ZONA DOCUMENTOS ─────────────────────── */
.zona-dni {
  flex: 1;
  background: var(--bg);
  padding: 24px;
  overflow-y: auto;
}

/* ── GRID ────────────────────────────────── */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  gap: 12px;
}

/* ── CARD ────────────────────────────────── */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 16px;
  cursor: pointer;
  transition: all 0.15s;
  position: relative;
}

.card:hover {
  border-color: var(--border-hover);
  background: var(--surface-2);
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.2);
}

.card-avatar {
  width: 36px; height: 36px;
  border-radius: 8px;
  background: var(--blue-dim);
  border: 1px solid var(--blue-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 700; color: var(--blue);
  margin-bottom: 10px;
}

.card h3 {
  font-size: 13px; font-weight: 600; color: var(--white);
  margin-bottom: 3px; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis;
}

.card p {
  font-size: 11px; color: var(--gray-400);
}

.card-badge {
  position: absolute; top: 10px; right: 10px;
  font-size: 10px; font-weight: 600; padding: 2px 7px;
  border-radius: 100px; background: var(--green-dim);
  color: var(--green); border: 1px solid rgba(63,185,80,0.2);
}

.card-badge.has-files {
  background: var(--amber-dim); color: var(--amber);
  border-color: rgba(210,153,34,0.2);
}

.btn-eliminar {
  margin-top: 12px; width: 100%;
  padding: 6px; border-radius: var(--radius-sm);
  border: none; background: var(--red-dim);
  color: var(--red); cursor: pointer; font-size: 12px;
  font-weight: 500; font-family: var(--font-body);
  transition: 0.15s;
}
.btn-eliminar:hover { background: rgba(248,81,73,0.18); }

/* ── EMPTY STATE ─────────────────────────── */
.empty-state {
  grid-column: 1 / -1;
  text-align: center; padding: 3rem 1rem;
  font-size: 13px; color: var(--gray-500);
  border: 1px dashed var(--border-hover);
  border-radius: var(--radius-lg);
}

/* ── MODALES ─────────────────────────────── */
.modal {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(4px);
  display: flex; align-items: center; justify-content: center;
  z-index: 100; padding: 1.5rem;
}

.modal-content {
  background: var(--surface);
  border: 1px solid var(--border-hover);
  width: 640px; max-width: 100%;
  border-radius: var(--radius-lg);
  padding: 0;
  display: flex; flex-direction: column;
  max-height: 90vh; overflow: hidden;
  box-shadow: 0 20px 60px rgba(0,0,0,0.4);
}

.modal-content.modal-sm { width: 420px; }

.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}

.modal-header h2 {
  font-size: 14px; font-weight: 600; color: var(--white);
}

.modal-header-meta {
  font-size: 11px; color: var(--gray-400); margin-top: 1px;
}

.modal-close {
  background: var(--surface-3); border: none;
  width: 26px; height: 26px; border-radius: 6px;
  color: var(--gray-300); cursor: pointer; font-size: 14px;
  display: flex; align-items: center; justify-content: center;
  transition: 0.15s; flex-shrink: 0;
}
.modal-close:hover { background: var(--red-dim); color: var(--red); }

.modal-body { padding: 20px; overflow-y: auto; flex: 1; }
.modal-body .input-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.modal-body label { font-size: 12px; font-weight: 500; color: var(--gray-300); }

.modal-body input[type="text"] {
  width: 100%; padding: 9px 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-hover);
  background: var(--bg); color: var(--white);
  font-family: var(--font-body); font-size: 13px; outline: none;
  transition: border-color 0.15s;
}
.modal-body input[type="text"]:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(47,129,247,0.1);
}

/* Tabs dentro del modal documento */
.modal-tabs {
  display: flex; gap: 0;
  border-bottom: 1px solid var(--border);
  padding: 0 20px;
}

.tab-btn {
  padding: 10px 16px; background: none; border: none;
  color: var(--gray-400); font-family: var(--font-body);
  font-size: 13px; font-weight: 500; cursor: pointer;
  border-bottom: 2px solid transparent; margin-bottom: -1px;
  transition: all 0.15s;
}
.tab-btn:hover { color: var(--white); }
.tab-btn.active { color: var(--blue); border-bottom-color: var(--blue); }

/* Textarea */
#editorTexto {
  width: 100%; min-height: 220px; padding: 14px;
  border-radius: var(--radius-sm); border: 1px solid var(--border-hover);
  background: var(--bg); color: var(--white);
  resize: vertical; outline: none; font-size: 13px;
  font-family: var(--font-body); line-height: 1.7;
  transition: border-color 0.15s;
}
#editorTexto:focus { border-color: var(--blue); }

/* ── ARCHIVOS ────────────────────────────── */
.drop-zone {
  border: 2px dashed var(--border-hover);
  border-radius: var(--radius-md);
  padding: 2rem 1rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.15s;
  margin-bottom: 1rem;
}
.drop-zone:hover, .drop-zone.dragover {
  border-color: var(--blue);
  background: var(--blue-dim);
}
.drop-zone-icon { font-size: 2rem; margin-bottom: 8px; }
.drop-zone-text { font-size: 13px; color: var(--gray-300); }
.drop-zone-sub  { font-size: 11px; color: var(--gray-500); margin-top: 4px; }

#fileInput { display: none; }

.archivos-lista { display: flex; flex-direction: column; gap: 8px; }

.archivo-item {
  display: flex; align-items: center; gap: 10px;
  background: var(--surface-2); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 10px 12px;
  transition: border-color 0.15s;
}
.archivo-item:hover { border-color: var(--border-hover); }

.archivo-icon {
  width: 32px; height: 32px; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; flex-shrink: 0;
  background: var(--surface-3);
}

.archivo-info { flex: 1; min-width: 0; }
.archivo-nombre { font-size: 13px; font-weight: 500; color: var(--white); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.archivo-meta   { font-size: 11px; color: var(--gray-400); }

.archivo-actions { display: flex; gap: 6px; flex-shrink: 0; }
.archivo-btn {
  padding: 5px 10px; border-radius: var(--radius-sm);
  border: none; font-size: 11px; font-weight: 500;
  cursor: pointer; font-family: var(--font-body); transition: 0.15s;
}
.archivo-btn.ver    { background: var(--blue-dim);  color: var(--blue); }
.archivo-btn.ver:hover { background: rgba(47,129,247,0.18); }
.archivo-btn.del    { background: var(--red-dim);   color: var(--red); }
.archivo-btn.del:hover { background: rgba(248,81,73,0.18); }

.upload-progress {
  background: var(--surface-2); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 10px 12px;
  display: flex; align-items: center; gap: 10px;
}
.progress-bar-wrap {
  flex: 1; height: 4px; background: var(--surface-3);
  border-radius: 2px; overflow: hidden;
}
.progress-bar { height: 100%; background: var(--blue); transition: width 0.2s; border-radius: 2px; }
.progress-text { font-size: 11px; color: var(--gray-400); flex-shrink: 0; }

/* ── MODAL FOOTER ────────────────────────── */
.modal-footer {
  padding: 14px 20px;
  border-top: 1px solid var(--border);
  display: flex; justify-content: flex-end; gap: 8px;
}

/* ── TOAST ───────────────────────────────── */
.toast-container {
  position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 999;
  display: flex; flex-direction: column; gap: 8px; pointer-events: none;
}
.toast {
  font-size: 12px; font-weight: 500;
  padding: 10px 16px; border-radius: var(--radius-sm);
  background: var(--surface-3); border: 1px solid var(--border-hover);
  color: var(--white); animation: toastIn 0.2s ease forwards;
  pointer-events: auto; max-width: 280px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.3);
}
.toast.success { border-color: rgba(63,185,80,0.3);  color: var(--green); }
.toast.error   { border-color: rgba(248,81,73,0.3);  color: var(--red); }
@keyframes toastIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── SELECT EN MODAL ─────────────────────── */
.modal-body select {
  width: 100%; padding: 9px 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-hover);
  background: var(--bg); color: var(--white);
  font-family: var(--font-body); font-size: 13px; outline: none;
  appearance: none;
}
.modal-body select:focus { border-color: var(--blue); }
.modal-body select option { background: var(--surface-2); }
